{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // ⚠⚠ EXPLICIT ON PURPOSE, AND IT CHANGES NOTHING TODAY. TypeScript 6 already defaults
    // `strict` to true, so this codebase has been strict-checked since the TS 6 upgrade —
    // measured 2026-08-12: 0 errors with it set, 0 with it unset, across all 137 source
    // files, while an explicit `"strict": false` makes a null misuse compile clean.
    //
    // ⚠ IT IS WRITTEN DOWN BECAUSE THE SILENCE WAS ALREADY MISREAD ONCE. Earlier the same
    // day, a pass read the missing key as "strict is off across the whole frontend" and
    // filed it as a large open hole in the backlog — inferring the compiler's behaviour
    // from the absence of a line rather than asking the compiler.
    //
    // ⚠ AND IT IS INSURANCE. A future TypeScript that reverts the default, or a downgrade
    // to TS 5.x, would turn strict OFF across all eight single-player games with no config
    // change and no error — the build would just get quieter. Do not "tidy" this away as
    // redundant with the default; being redundant with the default is the point.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // ⚠⚠ NO `exclude` HERE, DELIBERATELY. This used to carry
  //   "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
  // which meant `npm run build` and `npm run check` both passed while a test file called
  // a signature that no longer existed — only `npm test` caught it, and only if someone
  // ran it. That is what bit the pd pass on 08-10.
  //
  // ⚠ A test fixture that constructs a production type IS a type-check of that type, and
  // it is usually the first thing to rot when the type gains a field. Excluding tests
  // removes exactly the coverage most likely to catch drift. Do not re-add this.
  //
  // The 17 test files all import from 'vitest' explicitly, so no ambient `types` entry is
  // needed to bring them into this project — `include: ["src"]` is sufficient on its own.
  "include": ["src"]
}
