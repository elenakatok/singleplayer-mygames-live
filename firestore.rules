rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// Single-player family — ONE Firestore (default) database shared by every game in
// the `singleplayer-mygames-live` project. Isolation between games is by COLLECTION
// PREFIX, enforced here (architecture §4.2). Each game gets its own top-level
// prefixed match block. A game's rules MUST NOT be written in terms that could
// match another game's future collections — so every match path below is literally
// prefixed with `pennies_`, never a wildcard segment that could span games.
//
// Defining family constraint (architecture §1): a student never reads another
// student's data. Enforced in rules, not just in the UI — see the participant
// block's uid check.
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Jar of Pennies (game_id: pennies) ──────────────────────────────────────

    // Instance document: students read (to render config-derived screen chrome);
    // never client-written (the instructor creates/configures it server-side).
    match /pennies_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). Student-readable — it holds
      // only non-secret settings (e.g. the jar image path). The TRUE VALUE is NOT
      // here; it lives in truth/ below (spec §4.4), so config/main is safe to read.
      match /config/{doc} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // TRUTH / answer key (truth/main → true_value). DENY ALL CLIENT ACCESS —
      // read AND write, unconditionally, forever, with NO exception for the
      // instructor (the instructor reads/writes it only through an authenticated
      // callable). eBay vCommon pattern (spec §4.4): the pedagogical value of the
      // game depends on this never leaking. Do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — a PER-INSTANCE subcollection (spec §4.2). Isolation is
      // structural: the same student (stable participant_id across a course's instances)
      // gets a distinct doc per instance. A student may read ONLY their own doc AND only
      // under the instance they are authenticated for: request.auth.uid IS the
      // participant_id, and the custom token's game_instance_id claim must match this
      // instanceId — so a student cannot read their own doc under a DIFFERENT instance,
      // nor any other student's. No client writes (callables only).
      match /participants/{participantId} {
        allow read: if request.auth != null
          && request.auth.uid == participantId
          && request.auth.token.game_instance_id == instanceId;
        allow write: if false;
      }
    }

    // ── Poll (game_id: poll) ───────────────────────────────────────────────────

    // A poll has NO secret and NO truth document (Poll spec §8.3): the question
    // definitions ARE what the student answers, so config/main is client-readable.
    match /poll_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // The question list. Student-readable (they answer it); written only via
      // pollUpdateConfig. Deliberately NO truth/ subcollection — nothing is secret.
      match /config/{doc} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Participant document — per-INSTANCE subcollection (spec §8.2). Same structural
      // isolation as pennies: read only your OWN doc, and only under the instance you
      // are authenticated for (token game_instance_id claim must match). No client writes.
      match /participants/{participantId} {
        allow read: if request.auth != null
          && request.auth.uid == participantId
          && request.auth.token.game_instance_id == instanceId;
        allow write: if false;
      }
    }

    // ── Repeated Prisoner's Dilemma (game_id: pd) ──────────────────────────────

    match /pd_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). ⚠ DENIED TO ALL CLIENTS.
      // It holds the payoff matrix and the KC question list; an instructor-added KC
      // question carries `correct_value` and `explanation`, so a readable config/main is
      // a readable answer key (audit 2026-08-12). The drawn round count is NOT here — it
      // lives in truth/ below (PD spec §3: the actual round count is never displayed).
      //
      // ⚠⚠ THIS SAID "STUDENT-READABLE, AND SAFE TO BE" AND THAT CLAIM WAS FALSE.
      // Nothing under frontend/ imports `db` — every read, STUDENT AND INSTRUCTOR alike,
      // goes through a callable (see the "NOTE WHAT IS *NOT* IMPORTED: `db`" banners in
      // scorecard/api.ts, procurement/api.ts and forecast/api.ts). The grant was
      // vestigial, and the comment asserting a need that did not exist is exactly how it
      // survived. Do not restore it: if a screen ever genuinely needs a config field,
      // serve THAT FIELD from a callable rather than reopening the whole document.
      match /config/{doc} {
        allow read: if false;
        allow write: if false;
      }

      // TRUTH (truth/main → the drawn round count, and anything else the pedagogy
      // depends on staying hidden). DENY ALL CLIENT ACCESS — read AND write,
      // unconditionally, with NO exception for the instructor (who reads/writes it
      // only through an authenticated callable). Same eBay vCommon pattern as
      // pennies' true_value. Do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — per-INSTANCE subcollection, same structural isolation
      // as pennies and poll.
      //
      // ⚠ DELIBERATE DIVERGENCE FROM pennies/poll: read is DENIED OUTRIGHT, not
      // scoped to "your own doc". A PD participant doc carries the student's assigned
      // bot strategy (TFT vs GRIM) and their round history — and the whole pedagogy is
      // that the student INFERS the strategy from play (PD spec §5). Letting a student
      // read their own doc would hand them the answer through the Firestore SDK, so
      // every read goes through a callable that returns only what the student has
      // already earned. No client writes either (callables only).
      match /participants/{participantId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // ── Pricing Game / Cheyenne Shipping (game_id: pricing) ────────────────────

    match /pricing_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). ⚠ DENIED TO ALL CLIENTS.
      // It holds the market parameters (market size, base shares, unit costs, share
      // slope, price bounds), the PMG flag and the KC question list; an instructor-added
      // KC question carries `correct_value` and `explanation`, so a readable config/main
      // is a readable answer key (audit 2026-08-12). The drawn round count is NOT here;
      // it lives in truth/ below (Pricing spec §3: never displayed).
      //
      // ⚠⚠ THIS SAID THE PARAMETERS ARE "PRINTED ON THE PRICE-ENTRY SCREEN ANYWAY", AS
      // THOUGH THAT MADE THE GRANT NECESSARY. It does not: the screen gets them from a
      // callable, not from this document. Nothing under frontend/ imports `db` — every
      // read, student AND instructor, goes through a callable. Being shown a number is
      // not a reason to expose the document it happens to live in. Do not restore the
      // grant: serve the field from a callable instead.
      match /config/{doc} {
        allow read: if false;
        allow write: if false;
      }

      // TRUTH (truth/main → the drawn round count, and anything else the pedagogy
      // depends on staying hidden). DENY ALL CLIENT ACCESS — read AND write,
      // unconditionally, with NO exception for the instructor (who reads/writes it
      // only through an authenticated callable). Same eBay vCommon pattern as
      // pennies' true_value and pd's round count. Do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — per-INSTANCE subcollection, same structural isolation
      // as the rest of the family.
      //
      // ⚠ FOLLOWS PD, NOT pennies/poll: read is DENIED OUTRIGHT, not scoped to
      // "your own doc". A pricing participant doc carries the round history, and the
      // pedagogy is that the student infers the competitor's rule from play (spec
      // §5: the rule's identity is not shown until the debrief). A self-read would
      // expose whatever the compute step stores alongside that history — including,
      // once later slices land, the round the game ends on. Every student read goes
      // through a callable that returns only what the student has already earned.
      // No client writes either (callables only).
      match /participants/{participantId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // ── Newsvendor (game_id: newsvendor) ───────────────────────────────────────

    match /newsvendor_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). ⚠ DENIED TO ALL CLIENTS.
      // It holds the prices and costs (P, c, v, g, h), the demand distribution and its
      // parameters, the period count (not a secret in this game, unlike pricing) and the
      // KC question list; an instructor-added KC question carries `correct_value` and
      // `explanation`, so a readable config/main is a readable answer key
      // (audit 2026-08-12).
      //
      // ⚠⚠ THIS SAID THE FIGURES ARE "PRINTED ON THE PLACE-ORDER SCREEN ANYWAY" AND
      // TREATED THAT AS LICENCE. It is not: the screen gets them from a callable, never
      // from this document. Nothing under frontend/ imports `db` — every read, student
      // AND instructor, goes through a callable. A document is not safe to expose merely
      // because some of its fields are shown; it is safe to expose when EVERY field is,
      // and the KC list is not. Do not restore the grant.
      match /config/{doc} {
        allow read: if false;
        allow write: if false;
      }

      // TRUTH (truth/main → the DETERMINISM SEED). DENY ALL CLIENT ACCESS — read AND
      // write, unconditionally, with NO exception for the instructor (who reads and
      // writes it only through an authenticated callable).
      //
      // ⚠ WHY THE SEED IS HERE RATHER THAN IN config/main, WHERE PRICING KEEPS ITS
      // OWN: this game's seed derives every FUTURE DEMAND DRAW (functions
      // newsvendor/demand.ts). config/ above is student-readable, so a seed stored
      // there could be read with the plain SDK and used to compute period 12's demand
      // before ordering in period 11 — which is the whole game. Do not move it, and
      // do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — per-INSTANCE subcollection, same structural isolation
      // as the rest of the family.
      //
      // ⚠ READ IS DENIED OUTRIGHT, not scoped to "your own doc", and here that is
      // load-bearing for a specific reason: every stored period carries `q_opt` and
      // `profit_opt`, the benchmark the student must NEVER see (spec §9.2). A
      // self-read would hand them the optimal order for their own instance through
      // the Firestore SDK without a single callable being involved. Every student read
      // goes through a callable whose response is a hand-built whitelist
      // (functions newsvendor/rounds.ts). No client writes either (callables only).
      match /participants/{participantId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // ── Forecasting Game (game_id: forecast) ───────────────────────────────────

    match /forecast_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). ⚠ DENIED TO ALL CLIENTS.
      // It holds the history length, the played-month count (the header says "month k
      // of N" — spec §4), the forecast box bounds, the product and unit labels, the
      // KC/debrief switches AND the KC question list.
      //
      // ⚠⚠ THIS SAID "STUDENT-READABLE, AND EVERY FIELD IN IT IS SAFE TO BE". THE WORD
      // *EVERY* WAS THE BUG. An instructor-added KC question carries `correct_value` and
      // `explanation` and lives in this document, so the claim was false the moment
      // added questions shipped (audit 2026-08-12) — and the comment kept the grant
      // alive by asserting a safety nobody rechecked. Nothing under frontend/ imports
      // `db`; every read, student AND instructor, goes through a callable. Do not
      // restore the grant, and do not re-audit this document field by field — serve
      // whatever a screen needs from a callable instead.
      //
      // ⚠ THE DEMAND MODEL IS **NOT** HERE, and that is the inversion that separates
      // this game from newsvendor (functions forecast/config.ts). Newsvendor keeps its
      // economics in config because the student is shown all of it; here a, b, H, σ
      // and the high season ARE the answer — "explain the systematic variability" IS
      // the exercise (spec §7) — so they live in truth/ below. A student who could
      // read them off config/main with the plain SDK would be able to forecast the
      // conditional mean exactly, and the game would be over.
      match /config/{doc} {
        allow read: if false;
        allow write: if false;
      }

      // TRUTH (truth/main → the MODEL PARAMETERS **and** the determinism seed). DENY
      // ALL CLIENT ACCESS — read AND write, unconditionally, with NO exception for the
      // instructor (who reads and writes it only through an authenticated callable).
      // Same eBay vCommon pattern as pennies' true_value and newsvendor's seed.
      //
      // ⚠ THIS DOC HOLDS TWO SEPARATE SECRETS, EITHER OF WHICH ENDS THE GAME:
      //   • a, b, H, σ, highSeasonMonths — the systematic component the student is
      //     being asked to infer (spec §4, §7, §12);
      //   • the seed — it derives every FUTURE demand draw, so a student holding it
      //     could compute month 12's demand before forecasting month 11.
      // Do not move either into config, and do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — per-INSTANCE subcollection, same structural isolation
      // as the rest of the family.
      //
      // ⚠ READ IS DENIED OUTRIGHT, not scoped to "your own doc". A forecast
      // participant doc carries every REALIZED demand the student has faced — and once
      // a month is stored it is revealed anyway, so that part is not the risk. The risk
      // is that a self-read hands them whatever the compute step stores alongside it
      // without a single callable being involved. Every student read goes through a
      // callable whose response is a hand-built whitelist (functions forecast/
      // rounds.ts, clientState.ts), and unplayed months are never written at all. No
      // client writes either (callables only).
      match /participants/{participantId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // ── Procurement Auction (game_id: procurement) ─────────────────────────────
    //
    // ⚠ ONE BLOCK SERVES BOTH FORMATS. Sealed-bid and open-bid are two INSTANCES of one
    // game (spec Part 1 §14.1), so they share this prefix, these paths and these rules.
    // There is deliberately no procurement_open_ anything.

    match /procurement_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). ⚠ DENIED TO ALL CLIENTS.
      // It holds the format, the round count, the reserve, both cost ranges, the bid
      // increment, the open-format pacing AND the KC question list.
      //
      // ⚠⚠ THIS SAID "STUDENT-READABLE, AND EVERY FIELD IN IT IS SAFE TO BE … ALL OF IT
      // IS PRINTED ON THE BIDDING SCREEN ANYWAY". *EVERY* AND *ALL* WERE BOTH WRONG. An
      // instructor-added KC question carries `correct_value` and `explanation` and lives
      // here (audit 2026-08-12), and it is not printed anywhere. Nothing under frontend/
      // imports `db`; every read, student AND instructor, goes through a callable — so
      // the screen never needed this grant to show what it shows. Do not restore it.
      //
      // ⚠ THE RIVAL COST RANGE IS HERE ON PURPOSE, and it is the one field that looks
      // like it should be secret and is not. The equilibrium markup the debrief
      // discusses — and the line the Tier-3 scatter plots against — is only computable
      // by a student who knows the top of that range, and the lecture states it. This
      // game is NOT forecast: nothing about how a rival's cost is DRAWN is the answer to
      // anything. What must stay hidden is the seed, below.
      match /config/{doc} {
        allow read: if false;
        allow write: if false;
      }

      // TRUTH (truth/main → the DETERMINISM SEED). DENY ALL CLIENT ACCESS — read AND
      // write, unconditionally, with NO exception for the instructor (who reads and
      // writes it only through an authenticated callable). Same eBay vCommon pattern as
      // newsvendor's seed and forecast's model.
      //
      // ⚠ WHY THE SEED IS HERE RATHER THAN IN config/main: it derives every RIVAL COST
      // DRAW. config/ above is student-readable, so a seed stored there could be read
      // with the plain SDK and used to compute round 5's rival costs before bidding in
      // round 4 — which is the whole game. Do not move it, and do not relax this rule.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — a per-INSTANCE subcollection (architecture §4.2).
      // ⚠ NEVER top-level: that was a real v1 bug in both pennies and poll.
      //
      // ⚠ READ IS DENIED OUTRIGHT, not scoped to "your own doc", following PD, pricing,
      // newsvendor and forecast rather than pennies/poll. A participant doc carries the
      // resolved rounds, and Checkpoint 2 will store the rival costs alongside them for
      // the reports (spec Part 1 §4). A self-read would hand a student the losing
      // bidders' costs through the Firestore SDK without a callable being involved.
      // Every student read goes through a callable whose response is a hand-built
      // whitelist (functions procurement/rounds.ts). No client writes either.
      match /participants/{participantId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // ── Metalcraft Supplier Scorecard (game_id: scorecard) ─────────────────────

    match /scorecard_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). ⚠ DENIED TO ALL CLIENTS.
      // It holds the contract and period counts, the target score, the bonus, both
      // effort costs, P(acceptable | LOW effort), the endowment, the display switches,
      // the nouns AND the KC question list.
      //
      // ⚠⚠ THIS SAID "EVERY FIELD IN IT IS SAFE TO BE — SPEC §8 SAYS THE STUDENT IS TOLD
      // ALL OF IT". Spec §8 is about the GAME PARAMETERS and remains true of them; it
      // never spoke to the KC list, which arrived later and carries `correct_value` and
      // `explanation` on any instructor-added question (audit 2026-08-12). A safety
      // claim scoped to one set of fields silently became a claim about the whole
      // document. Nothing under frontend/ imports `db`; every read, student AND
      // instructor, goes through a callable, so nothing needed this grant. Do not
      // restore it.
      //
      // ⚠⚠ THE SPLIT HERE IS ABOUT THE EXPERIMENTAL DESIGN, NOT THE ECONOMICS — a
      // different seam from every other game in the family. Almost every number in
      // this game is printed on the student's own screen and must be. What is
      // withheld is that reliability ALTERNATES, that there are exactly TWO
      // conditions, and that the roster is counterbalanced (spec §8). So both
      // reliabilities and both labels live in truth/ below, even though one of each
      // is on screen at all times: holding the PAIR is what reveals the design.
      //
      // ⚠ `p_acceptable_low` IS here and that is CORRECT — it is displayed, and it
      // is IDENTICAL in both conditions (spec §2.1), so it discloses nothing about
      // the treatment. It is also the mechanism, which makes it exactly the number a
      // student is entitled to reason about.
      match /config/{doc} {
        allow read: if false;
        allow write: if false;
      }

      // TRUTH — DENY ALL CLIENT ACCESS, read AND write, unconditionally, with NO
      // exception for the instructor (who reaches it only through an authenticated
      // callable). Two documents live here:
      //
      //   truth/main   — reliability_high, reliability_low, reliability_schedule,
      //                  label_high, label_low, and the seed.
      //   truth/roster — the JOIN COUNTER that assigns `starts_with` in join order
      //                  (spec §2.2). Not secret in itself, but it is server-owned
      //                  state and a client write would break the exact 50/50 split
      //                  the counterbalancing depends on.
      //
      // ⚠ A student who could read truth/main would learn there are two conditions,
      // which one they are in, and what the next contract holds — every single thing
      // spec §8 says they are not told. Do not move any of it into config, and do not
      // relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — per-INSTANCE subcollection (S2, architecture §4.2).
      //
      // ⚠ READ IS DENIED OUTRIGHT, not scoped to "your own doc". A scorecard
      // participant doc carries `starts_with` — from which the ENTIRE schedule
      // derives, including every contract not yet played — plus the raw draw `u` for
      // every period. Either would end the exercise: the first reveals the design,
      // the second makes the next outcome predictable. Every student read goes
      // through a callable whose response is a hand-built whitelist (functions
      // scorecard/clientState.ts). No client writes either (callables only).
      match /participants/{participantId} {
        allow read: if false;
        allow write: if false;
      }
    }
  }
}
