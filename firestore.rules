rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// Single-player family — ONE Firestore (default) database shared by every game in
// the `singleplayer-mygames-live` project. Isolation between games is by COLLECTION
// PREFIX, enforced here (architecture §4.2). Each game gets its own top-level
// prefixed match block. A game's rules MUST NOT be written in terms that could
// match another game's future collections — so every match path below is literally
// prefixed with `pennies_`, never a wildcard segment that could span games.
//
// Defining family constraint (architecture §1): a student never reads another
// student's data. Enforced in rules, not just in the UI — see the participant
// block's uid check.
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Jar of Pennies (game_id: pennies) ──────────────────────────────────────

    // Instance document: students read (to render config-derived screen chrome);
    // never client-written (the instructor creates/configures it server-side).
    match /pennies_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). Student-readable — it holds
      // only non-secret settings (e.g. the jar image path). The TRUE VALUE is NOT
      // here; it lives in truth/ below (spec §4.4), so config/main is safe to read.
      match /config/{doc} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // TRUTH / answer key (truth/main → true_value). DENY ALL CLIENT ACCESS —
      // read AND write, unconditionally, forever, with NO exception for the
      // instructor (the instructor reads/writes it only through an authenticated
      // callable). eBay vCommon pattern (spec §4.4): the pedagogical value of the
      // game depends on this never leaking. Do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — a PER-INSTANCE subcollection (spec §4.2). Isolation is
      // structural: the same student (stable participant_id across a course's instances)
      // gets a distinct doc per instance. A student may read ONLY their own doc AND only
      // under the instance they are authenticated for: request.auth.uid IS the
      // participant_id, and the custom token's game_instance_id claim must match this
      // instanceId — so a student cannot read their own doc under a DIFFERENT instance,
      // nor any other student's. No client writes (callables only).
      match /participants/{participantId} {
        allow read: if request.auth != null
          && request.auth.uid == participantId
          && request.auth.token.game_instance_id == instanceId;
        allow write: if false;
      }
    }

    // ── Poll (game_id: poll) ───────────────────────────────────────────────────

    // A poll has NO secret and NO truth document (Poll spec §8.3): the question
    // definitions ARE what the student answers, so config/main is client-readable.
    match /poll_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // The question list. Student-readable (they answer it); written only via
      // pollUpdateConfig. Deliberately NO truth/ subcollection — nothing is secret.
      match /config/{doc} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Participant document — per-INSTANCE subcollection (spec §8.2). Same structural
      // isolation as pennies: read only your OWN doc, and only under the instance you
      // are authenticated for (token game_instance_id claim must match). No client writes.
      match /participants/{participantId} {
        allow read: if request.auth != null
          && request.auth.uid == participantId
          && request.auth.token.game_instance_id == instanceId;
        allow write: if false;
      }
    }

    // ── Repeated Prisoner's Dilemma (game_id: pd) ──────────────────────────────

    match /pd_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). STUDENT-READABLE, and safe to
      // be: it holds only the payoff matrix, which the student is shown anyway. The
      // drawn round count is NOT here — it lives in truth/ below (PD spec §3: the
      // actual round count is never displayed).
      match /config/{doc} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // TRUTH (truth/main → the drawn round count, and anything else the pedagogy
      // depends on staying hidden). DENY ALL CLIENT ACCESS — read AND write,
      // unconditionally, with NO exception for the instructor (who reads/writes it
      // only through an authenticated callable). Same eBay vCommon pattern as
      // pennies' true_value. Do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — per-INSTANCE subcollection, same structural isolation
      // as pennies and poll.
      //
      // ⚠ DELIBERATE DIVERGENCE FROM pennies/poll: read is DENIED OUTRIGHT, not
      // scoped to "your own doc". A PD participant doc carries the student's assigned
      // bot strategy (TFT vs GRIM) and their round history — and the whole pedagogy is
      // that the student INFERS the strategy from play (PD spec §5). Letting a student
      // read their own doc would hand them the answer through the Firestore SDK, so
      // every read goes through a callable that returns only what the student has
      // already earned. No client writes either (callables only).
      match /participants/{participantId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // ── Pricing Game / Cheyenne Shipping (game_id: pricing) ────────────────────

    match /pricing_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). STUDENT-READABLE, and safe to
      // be: it holds the market parameters (market size, base shares, unit costs,
      // share slope, price bounds) and the PMG flag — every one of which is printed
      // on the price-entry screen anyway. The drawn round count is NOT here; it
      // lives in truth/ below (Pricing spec §3: never displayed).
      match /config/{doc} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // TRUTH (truth/main → the drawn round count, and anything else the pedagogy
      // depends on staying hidden). DENY ALL CLIENT ACCESS — read AND write,
      // unconditionally, with NO exception for the instructor (who reads/writes it
      // only through an authenticated callable). Same eBay vCommon pattern as
      // pennies' true_value and pd's round count. Do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — per-INSTANCE subcollection, same structural isolation
      // as the rest of the family.
      //
      // ⚠ FOLLOWS PD, NOT pennies/poll: read is DENIED OUTRIGHT, not scoped to
      // "your own doc". A pricing participant doc carries the round history, and the
      // pedagogy is that the student infers the competitor's rule from play (spec
      // §5: the rule's identity is not shown until the debrief). A self-read would
      // expose whatever the compute step stores alongside that history — including,
      // once later slices land, the round the game ends on. Every student read goes
      // through a callable that returns only what the student has already earned.
      // No client writes either (callables only).
      match /participants/{participantId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // ── Newsvendor (game_id: newsvendor) ───────────────────────────────────────

    match /newsvendor_game_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-instance instructor config (config/main). STUDENT-READABLE, and safe to
      // be: it holds the prices and costs (P, c, v, g, h), the demand distribution
      // and its parameters, and the period count — every one of which is printed on
      // the place-order screen anyway (spec §7a). Unlike pricing, the period count
      // is NOT a secret in this game.
      match /config/{doc} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // TRUTH (truth/main → the DETERMINISM SEED). DENY ALL CLIENT ACCESS — read AND
      // write, unconditionally, with NO exception for the instructor (who reads and
      // writes it only through an authenticated callable).
      //
      // ⚠ WHY THE SEED IS HERE RATHER THAN IN config/main, WHERE PRICING KEEPS ITS
      // OWN: this game's seed derives every FUTURE DEMAND DRAW (functions
      // newsvendor/demand.ts). config/ above is student-readable, so a seed stored
      // there could be read with the plain SDK and used to compute period 12's demand
      // before ordering in period 11 — which is the whole game. Do not move it, and
      // do not relax this rule, ever.
      match /truth/{doc} {
        allow read, write: if false;
      }

      // Participant document — per-INSTANCE subcollection, same structural isolation
      // as the rest of the family.
      //
      // ⚠ NO STUDENT MAY EVER READ A PARTICIPANT DOC, and that is load-bearing for a
      // specific reason: every stored period carries `q_opt` and `profit_opt`, the
      // benchmark the student must NEVER see (spec §9.2). A self-read would hand them
      // the optimal order for their own instance through the Firestore SDK without a
      // single callable being involved. Every student read goes through a callable
      // whose response is a hand-built whitelist (functions newsvendor/rounds.ts).
      //
      // ⚠ THE INSTANCE'S OWN INSTRUCTOR MAY READ, AND ONLY AS A CHANGE SIGNAL. The
      // dashboard subscribes to this subcollection so it refreshes as students play
      // (see frontend newsvendor/Dashboard.tsx); it reads NO FIELD off the snapshot and
      // renders nothing from it — every number on screen still comes from
      // newsvendorGetReport, which stays the one authority. The gate is the instructor
      // session's own custom claims, minted by makeSinglePlayerInstructorSession:
      // role 'instructor' AND this exact instance. A student's token carries neither
      // claim (their uid is their participant_id and their role defaults to 'student'),
      // so this widens nothing for them. It also exposes the instructor to nothing new:
      // the benchmark is already in every newsvendorGetReport response they receive.
      //
      // Writes stay closed to every client, instructor included — callables only.
      match /participants/{participantId} {
        allow read: if request.auth != null
                    && request.auth.token.role == 'instructor'
                    && request.auth.token.game_instance_id == instanceId;
        allow write: if false;
      }
    }
  }
}
